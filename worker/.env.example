# ============================================================
# ZIULBOT Worker — variáveis de ambiente
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA suba o ".env" real para o Git (já vem no .gitignore).
# ============================================================

# App Kick (mesmos valores do site principal)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Canal onde o bot vai comentar
KICK_CHANNEL=odudutips

# Chave da Groq (console.groq.com/keys)
GROQ_API_KEY=

# Supabase (armazena o token de sessão da Kick de forma persistente)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Timing dos comentários
INTERVAL_SECONDS=30
JITTER_SECONDS=8

# Persona da IA (deixe em branco para usar o padrão)
PERSONA=

# Mensagens de fallback caso a IA falhe (separadas por vírgula)
FALLBACK_MESSAGES=Boa live! 🔥,GG chat 👏,Bora pra cima!! 💪

# Porta do mini servidor HTTP de health-check (exigido pelo Koyeb Web Service)
PORT=8000

# ── Usado APENAS no bootstrap-token.js (uma única vez) ──
# Pegue esse valor no navegador, depois de clicar "Conectar com Kick" em kick-bot.html:
#   1. F12 → Console
#   2. Digite: JSON.parse(localStorage.getItem('ziulbot_kick_auth')).refresh_token
#   3. Cole o resultado aqui
KICK_INITIAL_REFRESH_TOKEN=
